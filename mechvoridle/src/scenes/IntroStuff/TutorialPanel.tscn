[node name="Body" type="Label" parent="TutorialPanels/VulcanMachineGunPane"]
layout_mode = 0
offset_left = 26.0
offset_top = 58.0
offset_right = 323.0
offset_bottom = 343.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 9
text = "The Vulcan Machine Gun is a low damage yet reliable fallback Weapon for when weapons are on cooldown. 

This weapon is available to the player at all times, yet the weapon will generate small amounts of heat which you must take into account with the usage of other weapons.

The player can activate the vulcan Machine Gun by pressing and holding [space bar].

The vulcan machine gun's damage Synergizes with the Counter Guard mechanic. a temporary multiplier will be applied based on the grade of the counter guard (more on this in the Counter Guard Tutorial)

"
autowrap_mode = 3

