[node name="Body" type="Label" parent="TutorialPanels/CounterGuardPane"]
layout_mode = 0
offset_left = 26.0
offset_top = 58.0
offset_right = 399.0
offset_bottom = 354.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 9
text = "Counter guard is primarily a tempo and attack enhancer. It will also block incoming enemy damage, but will consume Energy. If energy bar is depleted, Counter guard will be disabled until the bar refils.

When encountering an enemy attack, the player will have the ability to execute a \"counter guard\". 

This is an ability represented with a brief yellow \"shine\" effect around the player. 

Counter guard is necessary for keeping fast paced gameplay and survival. Counter guarding with precise timing will provide the following benefits:

- Weapon cooldown reduction
- less Counter-Guard Energy Consumption
- heat reduction"
autowrap_mode = 3

