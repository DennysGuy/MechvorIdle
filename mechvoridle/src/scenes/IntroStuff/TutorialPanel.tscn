[node name="Body" type="Label" parent="TutorialPanels/BasicMovementPane"]
layout_mode = 0
offset_left = 26.0
offset_top = 58.0
offset_right = 312.0
offset_bottom = 349.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 9
text = "All Combat participants operate on a 'Grid System' meaning every movement or combat option will be bound to the Grid. 

All actions are executed in real time. combat is about timing, tempo, and positioning.

Player movement is confined to the Left most row of the grid. This can be best visualized as traversing linerally across lanes. Another movement input cannot be made until you have reached a destined tile.

Moving across lanes can be executed using the [left/right] movement controls"
autowrap_mode = 3

