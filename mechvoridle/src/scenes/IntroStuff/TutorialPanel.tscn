[node name="Body" type="Label" parent="TutorialPanels/BasicMovementPane"]
layout_mode = 0
offset_left = 27.0
offset_top = 58.0
offset_right = 336.0
offset_bottom = 293.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 10
text = "Grid System: 

All combat participants operate on a 4x6 grid—every movement and combat action is grid-bound and executed in real time. Combat revolves around timing, tempo, and positioning.

Player Movement: 

Confined to the leftmost row, moving linearly across lanes. Another movement input cannot be made until reaching the destination tile.

Controls: 

Use [Left/Right] to move across lanes."
autowrap_mode = 3

