[node name="Body" type="Label" parent="TutorialPanels/ActiveCoolDownAttacksPane"]
layout_mode = 0
offset_left = 26.0
offset_top = 58.0
offset_right = 313.0
offset_bottom = 341.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 9
text = "Active Cooldown Weapons are your primary damage dealers. You have access to 2 weapons (eventually equipped via Mech Customization Menu).

Grid-Based Attacks: Weapons target grid patterns i.e. whole lanes, rows, grid sections, or individual tiles. Attack patterns vary by weapon and sub-class.

Cooldown System: After executing an attack, weapons enter cooldown before becoming available again. Cooldowns vary per weapon and can be reduced through gameplay options.

Heat Generation: Each attack generates heat based on a fraction of the weapon's damage output."
autowrap_mode = 3

