theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 9
text = "Counter Guard Grading System: Grades are awarded based on timing, following a \"risk\" model—the closer the enemy attack is upon activation (less time Counter Guard is active), the higher the reward.
Grading Tiers:

- Perfect (highest rewards)
- Great
- Okay (lowest rewards)
- No Grade (no rewards)

Perfect Guard Multiplier: 

Landing a Perfect Guard grants a Vulcan multiplier stack that increments with consecutive Perfects. Breaking the streak resets the stack to the lower grade's multiplier.

Multiplier Application: The stack is consumed and applied when executing a cooldown weapon attack, then resets to default."
autowrap_mode = 3

