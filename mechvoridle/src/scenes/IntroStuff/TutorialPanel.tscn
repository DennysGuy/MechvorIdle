theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 10
text = "Problem: Since movement inputs require reaching the destination tile first, waiting to Guard after arrival can result in significant damage during transit.

Guard-Sliding Solution: A technique that carries Counter Guard activation into the next tile. Execute by activating Counter Guard right before moving. This may require fast input to maintain the highest guard grade (think of this akin to a simpler wave dash).

Benefits: Makes navigating dense enemy fire sequences manageable and survivable (also useful for certain challenge waves)."
autowrap_mode = 3

