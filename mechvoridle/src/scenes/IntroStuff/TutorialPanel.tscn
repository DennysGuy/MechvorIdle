text = "Active Cooldown Attacks"

[node name="Body" type="Label" parent="TutorialPanels/ActiveCoolDownAttacksPane"]
layout_mode = 0
offset_left = 26.0
offset_top = 58.0
offset_right = 371.0
offset_bottom = 380.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_pbvyl")
theme_override_font_sizes/font_size = 8
text = "You will have access to 2 active Cooldown weapons that will be (eventually) Equipped In the Mech Customization Menu. 

Active cooldown Weapons are your Primary Way of dealing damage!

Weapons will have an active cooldown that vary per weapon and Weapon Sub-Class. 

Active Cooldown attacks rely on a grid pattern to do damage. For example: Some Attacks will attack whole lanes, rows, Target sections of the grid or an individual tile.

once a weapon attack is executed, The player will have to wait a brief cooldown before the weapon becomes available once more; however, during down time, the player will have options to reduce cooldown.

**Heat is generated after each attack. This is based on applying a fraction of the damage output of the weapon."
autowrap_mode = 3

